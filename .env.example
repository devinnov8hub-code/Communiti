# Backend origin. Usually leave empty: in development the app calls /api on the Vite dev server,
# which proxies to https://api.mycommuniti.org (vite.config.ts), and production builds default to
# https://api.mycommuniti.org. Set it only to point at another backend (e.g. a staging API).
VITE_API_BASE_URL=

# Supabase Realtime (live chat messages and notifications), see src/lib/realtime.ts.
# Without these the app polls instead. VITE_SUPABASE_KEY must be the anon / publishable key —
# never the secret / service_role key: every VITE_ value is visible in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
