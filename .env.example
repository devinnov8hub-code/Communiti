# Leave empty for now: the screens still run on built-in sample data, and setting this
# switches them to placeholder endpoints before they are connected to src/lib/api.
#
# The backend client in src/lib/api does not need it: in development it goes through the
# Vite proxy (/api -> https://api.mycommuniti.org) and in production it defaults to
# https://api.mycommuniti.org.
VITE_API_BASE_URL=
